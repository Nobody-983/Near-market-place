
# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# NEAR Configuration (Testnet)
VITE_NEAR_NETWORK_ID=testnet
VITE_NEAR_NODE_URL=https://rpc.testnet.near.org
VITE_NEAR_WALLET_URL=https://testnet.mynearwallet.com/
VITE_NEAR_HELPER_URL=https://helper.testnet.near.org
VITE_NEAR_EXPLORER_URL=https://testnet.nearblocks.io

# Deployed RoundFrog NEAR Testnet contracts. Keep marketplace action gates
# disabled in src/config/marketplace.js until end-to-end checks pass.
VITE_NFT_CONTRACT_ID=nft.roundfrog-dev.testnet
VITE_MARKETPLACE_CONTRACT_ID=market.roundfrog-dev.testnet
VITE_NFT_MINT_DEPOSIT_YOCTO=50000000000000000000000
VITE_NFT_APPROVAL_DEPOSIT_YOCTO=10000000000000000000000
VITE_MARKETPLACE_LISTING_STORAGE_YOCTO=120000000000000000000000

# Release evidence switch. Keep false until real finalized listing and
# cancellation receipts, catalog-indexer reconciliation, and hosted Supabase
# results have been reviewed together. Contract deployment alone is insufficient.
VITE_TESTNET_LISTING_FLOW_VERIFIED=false

# Keep false until the Testnet mint authority, finalized mint receipts, catalog
# binding/indexing, and wallet-to-catalog ownership lifecycle are verified.
VITE_TESTNET_MINT_FLOW_VERIFIED=false

# Keep false until settlement verification, payout, and receipt flows are verified.
VITE_TESTNET_PURCHASE_FLOW_VERIFIED=false


# Display-only demo listings. Leave false: demo rows must never be mixed with
# real indexed marketplace data. Enable only for offline UI review.
VITE_PREVIEW_DATA_ENABLED=false

# Never add a Supabase secret/service-role key to any VITE_* variable.
