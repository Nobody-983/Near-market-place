# Trusted settlement worker environment. Copy outside version control and fill
# secrets locally. Never put SUPABASE_SERVICE_ROLE_KEY in a VITE_* variable or
# commit a populated copy of this file.
#
# Both the purchase verifier and the withdrawal/refund reconciler run in this
# worker, so the same process handles buys, seller/fee proceeds, buyer refunds,
# storage withdrawals and registration-excess refunds.

NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_MARKETPLACE_CONTRACT_ID=market.roundfrog-dev.testnet
NEAR_NFT_CONTRACT_ID=nft.roundfrog-dev.testnet
NEAR_MARKETPLACE_CODE_HASH=Fp3ggF3WmSMQC7m9FU717jA8nB897sYW6bik7Ysqipw7
NEAR_NFT_CODE_HASH=DRmwjtfeBzXW2XgXMumytEY5scsDzEtCGsbVNKjdEtW8

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server runtime only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_THE_SERVER_RUNTIME

# Durable local scan checkpoint and advisory audit ledger.
SETTLEMENT_PROCESSED_PATH=./var/settlement-processed.jsonl

# First finalized block the worker should scan when no checkpoint exists.
# Set this to the finalized height recorded immediately before the first demo
# transaction. Without it the worker starts 100 blocks behind the final head.
SETTLEMENT_START_HEIGHT=
